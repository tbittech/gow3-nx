@@ -794,6 +874,9 @@ static void pad_poll_backend(void)
     pad_poll_sdl2();
 #endif
     if (!s_host_state[0].connected) pad_poll_keyboard();
+#ifdef __SWITCH__
+    pad_autotest_p1(&s_host_state[0]);
+#endif
     pad_track_assign();
     pad_unlock();
 }
