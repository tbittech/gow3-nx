+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/runtime/platform/switch_srw.c b/runtime/platform/switch_srw.c
new file mode 100644
index 00000000..2948ccfd
--- /dev/null
+++ b/runtime/platform/switch_srw.c
@@ -0,0 +1,58 @@
+/* 80c: Win32 SRW locks on libnx RwLock (see win32_compat.h). */
+#if defined(__SWITCH__)
+
+#include <switch.h>
+#include <stdlib.h>
+
+void* ps3_nx_rwl_new(void)
+{
+    RwLock* r = (RwLock*)calloc(1, sizeof(*r));
+
+    if (r)
+        rwlockInit(r);
+
+    return r;
+}
+
+void ps3_nx_wlock(void* r)
+{
+    int i;
+
+    for (i = 0; i < 256; ++i)
+    {
+        if (rwlockTryWriteLock((RwLock*)r))
+            return;
+
+        if (i != 255)
+            __asm__ __volatile__("yield" ::: "memory");
+    }
+
+    rwlockWriteLock((RwLock*)r);
+}
+
+void ps3_nx_wunlock(void* r)
+{
+    rwlockWriteUnlock((RwLock*)r);
+}
+
+int ps3_nx_trywlock(void* r)
+{
+    return rwlockTryWriteLock((RwLock*)r);
+}
+
+void ps3_nx_rlock(void* r)
+{
+    rwlockReadLock((RwLock*)r);
+}
+
+void ps3_nx_runlock(void* r)
+{
+    rwlockReadUnlock((RwLock*)r);
+}
+
+int ps3_nx_tryrlock(void* r)
+{
+    return rwlockTryReadLock((RwLock*)r);
+}
+
+#endif
