+        "    if (!(d > 0.0)) return 0u;\n"
+        "    uint b = asuint(d);\n"
+        "    uint e = (b >> 23) & 0xFFu;\n"
+        "    uint m = (b & 0x7FFFFFu) | (e != 0u ? 0x800000u : 0u);\n"
+        "    uint s = 150u - max(e, 1u);\n"
+        "    uint lo = m << 24;\n"
+        "    uint hi = m >> 8;\n"
+        "    uint borrow = (lo < m) ? 1u : 0u;\n"
+        "    lo = lo - m; hi = hi - borrow;\n"
+        "    uint hb = s - 1u;\n"
+        "    if (hb < 32u) { uint t = lo + (1u << hb); hi += (t < lo) ? 1u : 0u; lo = t; }\n"
+        "    else if (hb < 64u) { hi += 1u << (hb - 32u); }\n"
+        "    if (s >= 64u) return 0u;\n"
+        "    if (s >= 32u) return hi >> (s - 32u);\n"
