diff --git a/libs/input/cellPad.c b/libs/input/cellPad.c
index 5f8a2fa2..1f900920 100644
--- a/libs/input/cellPad.c
+++ b/libs/input/cellPad.c
@@ -708,6 +708,19 @@ static void pad_poll_sdl2(void)
         s_host_state[i].press_l1       = (btns & CELL_PAD_CTRL_L1)       ? 255 : 0;
         s_host_state[i].press_r1       = (btns & CELL_PAD_CTRL_R1)       ? 255 : 0;
     }
+#ifdef __SWITCH__
+    /* 67a (gow3-nx): SDL opens 4 controllers and the title reads only port 0;
+     * sys-botbase's virtual pad lands on another one. Fold ports 1-3 into 0. */
+    for (int i = 1; i < PAD_MAX_HOST_PORTS; i++) {
+        PadHostState *d = &s_host_state[0], *s = &s_host_state[i];
+        if (!s->connected) continue;
+        d->connected = 1;
+        d->buttons |= s->buttons;
+        u8 *dp = &d->trigger_l2, *sp = &s->trigger_l2;   /* trigger_l2..press_r1: contiguous u8 */
+        for (int k = 0; k <= (int)(&d->press_r1 - &d->trigger_l2); k++) if (sp[k] > dp[k]) dp[k] = sp[k];
+        if (s->analog_lx < 64 || s->analog_lx > 192 || s->analog_ly < 64 || s->analog_ly > 192) { d->analog_lx = s->analog_lx; d->analog_ly = s->analog_ly; }
