+/* FS_REDIRECT=SRC=DST: use the host path with SRC replaced by DST (open and
+ * stat). GoW3 plays OPENINGCREDITS.M2V (~7700 AUs, ~26 min at our frame rate)
+ * before the menu; OPENINGCREDITS.M2V=SMLOGO.M2V swaps in the 330-AU logo. */
+static void fs_redirect(char* hpath, size_t n, const char* gpath)
+{
+    const char* r = getenv("FS_REDIRECT");
+    const char* eq = r ? strchr(r, '=') : nullptr;
+    size_t sl = eq ? (size_t)(eq - r) : 0;
+    if (sl == 0 || sl >= 128) return;
+    char src[128]; memcpy(src, r, sl); src[sl] = 0;
+    char* p = strstr(hpath, src);
+    if (!p) return;
+    char tmp[1100];
+    snprintf(tmp, sizeof tmp, "%.*s%s%s", (int)(p - hpath), hpath, eq + 1, p + sl);
+    snprintf(hpath, n, "%s", tmp);
+    fprintf(stderr, "[fs] redirect '%s' -> '%s'\n", gpath, hpath);
+}
