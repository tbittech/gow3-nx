 static void pad_init_backend(void)
@@ -776,6 +789,73 @@ static unsigned long long pad_now_ms(void)
 #endif
 }
 
+#ifdef __SWITCH__
+/* 62a (gow3-nx): devkitnx autotest on player 1. --at-record records the
+ * buttons (and the left stick as the d-pad) in HidNpadButton bits; --at-input
+ * replays them. The mapping is positional (CROSS = bottom = B, CIRCLE = A,
+ * SQUARE = Y, TRIANGLE = X, SELECT = MINUS, START = PLUS). GoW3 moves with the
+ * analog stick and the recording keeps no stick, so on replay the d-pad is fed
+ * as the left stick at full tilt (GOW3_AT_DPAD_AS_STICK=0 keeps it a d-pad):
+ * record without touching the real d-pad. */
+#include "autotest.h"
+static const struct { u16 cell; u32 hid; } s_at_map[] = {
+    { CELL_PAD_CTRL_CROSS, 1u << 1 },  { CELL_PAD_CTRL_CIRCLE, 1u << 0 },
+    { CELL_PAD_CTRL_SQUARE, 1u << 3 }, { CELL_PAD_CTRL_TRIANGLE, 1u << 2 },
+    { CELL_PAD_CTRL_L3, 1u << 4 },     { CELL_PAD_CTRL_R3, 1u << 5 },
+    { CELL_PAD_CTRL_L1, 1u << 6 },     { CELL_PAD_CTRL_R1, 1u << 7 },
+    { CELL_PAD_CTRL_L2, 1u << 8 },     { CELL_PAD_CTRL_R2, 1u << 9 },
+    { CELL_PAD_CTRL_START, 1u << 10 }, { CELL_PAD_CTRL_SELECT, 1u << 11 },
+    { CELL_PAD_CTRL_LEFT, 1u << 12 },  { CELL_PAD_CTRL_UP, 1u << 13 },
+    { CELL_PAD_CTRL_RIGHT, 1u << 14 }, { CELL_PAD_CTRL_DOWN, 1u << 15 },
+};
+#define AT_MAP_N ((int)(sizeof s_at_map / sizeof s_at_map[0]))
+
+static void pad_autotest_p1(PadHostState* hs)
+{
+    static int dpad_as_stick = -1;
+    uint64_t m = 0, scripted;
+    int i;
+    if (dpad_as_stick < 0) {
+        const char* e = getenv("GOW3_AT_DPAD_AS_STICK");
+        dpad_as_stick = (e && *e == '0') ? 0 : 1;
+    }
+    if (at_input(&scripted)) {
+        u16 b = 0;
+        for (i = 0; i < AT_MAP_N; i++) if (scripted & s_at_map[i].hid) b |= s_at_map[i].cell;
+        hs->connected = 1;
+        hs->analog_lx = hs->analog_ly = hs->analog_rx = hs->analog_ry = 128;
+        if (dpad_as_stick) {
+            if (b & CELL_PAD_CTRL_LEFT)  hs->analog_lx = 0;
+            if (b & CELL_PAD_CTRL_RIGHT) hs->analog_lx = 255;
+            if (b & CELL_PAD_CTRL_UP)    hs->analog_ly = 0;
+            if (b & CELL_PAD_CTRL_DOWN)  hs->analog_ly = 255;
+            b &= (u16)~(CELL_PAD_CTRL_LEFT | CELL_PAD_CTRL_RIGHT | CELL_PAD_CTRL_UP | CELL_PAD_CTRL_DOWN);
+        }
+        hs->buttons = b;
+        hs->trigger_l2 = (b & CELL_PAD_CTRL_L2) ? 255 : 0;
+        hs->trigger_r2 = (b & CELL_PAD_CTRL_R2) ? 255 : 0;
+        hs->press_up = hs->press_down = hs->press_left = hs->press_right = 0;
+        hs->press_triangle = (b & CELL_PAD_CTRL_TRIANGLE) ? 255 : 0;
+        hs->press_circle   = (b & CELL_PAD_CTRL_CIRCLE)   ? 255 : 0;
+        hs->press_cross    = (b & CELL_PAD_CTRL_CROSS)    ? 255 : 0;
+        hs->press_square   = (b & CELL_PAD_CTRL_SQUARE)   ? 255 : 0;
+        hs->press_l1       = (b & CELL_PAD_CTRL_L1)       ? 255 : 0;
+        hs->press_r1       = (b & CELL_PAD_CTRL_R1)       ? 255 : 0;
+        return;
+    }
+    if (!hs->connected) return;
+    for (i = 0; i < AT_MAP_N; i++) if (hs->buttons & s_at_map[i].cell) m |= s_at_map[i].hid;
+    if (hs->analog_lx < 64)  m |= 1u << 16;   /* StickLLeft  */
+    if (hs->analog_ly < 64)  m |= 1u << 17;   /* StickLUp    */
+    if (hs->analog_lx > 192) m |= 1u << 18;   /* StickLRight */
+    if (hs->analog_ly > 192) m |= 1u << 19;   /* StickLDown  */
+    m = at_record(m);
+    /* The mark button (--at-record-mark) comes back cleared: hide it from the game. */
+    for (i = 0; i < AT_MAP_N; i++)
+        if (!(m & s_at_map[i].hid) && s_at_map[i].hid < (1u << 12)) hs->buttons &= (u16)~s_at_map[i].cell;
+}
+#endif
+
 static void pad_poll_backend(void)
 {
