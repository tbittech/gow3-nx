+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum {
+    RSX_REL_1D74,
+    RSX_REL_1D70,
+    SEM_REL_6C,
+    SEM_ACQ_BLOCK,
+    SEM_ACQ_PASS,
+    SET_REF,
+    PPU_WAIT_ENTER,
+    PPU_CLEAR,
+    PPU_FLAG_1BD8E8,
+    PPU_EMIT_299,
+    PPU_EMIT_26D,
